// Core M1 model (README §4). Every table with a school_id has an RLS policy, added by hand in its migration.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  owner
  admin
  instructor
  student
}

enum CourseStatus {
  draft
  published
}

enum LessonType {
  video
  text
  pdf
}

enum OrderStatus {
  pending
  paid
  failed
  refunded
}

/// How the student chose to pay; each has a gateway in apps/api.
enum PaymentMethod {
  stripe
  aba_payway
  bakong_khqr
}

enum CouponKind {
  percent
  fixed
}

enum EnrollmentSource {
  purchase
  manual
}

/// A person. Global: one account can belong to many schools.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String?
  /// Null for accounts that only sign in by magic link.
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  orders      Order[]
  enrollments Enrollment[]
  sessions    Session[]
  auditEvents AuditEvent[]

  @@map("users")
}

/// A signed-in browser. Global, like users. Only the SHA-256 of the cookie token is stored.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// A pending one-time sign-in link. Keyed by email, since the account may not exist yet.
model MagicLinkToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  email     String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("magic_link_tokens")
}

/// A tenant: one creator's branded school.
model School {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  subdomain  String   @unique
  brandColor String?  @map("brand_color")
  /// Object-storage key of the logo; the API signs it into a URL.
  logoKey    String?  @map("logo_key")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  memberships      Membership[]
  courses          Course[]
  sections         Section[]
  lessons          Lesson[]
  prices           Price[]
  orders           Order[]
  orderItems       OrderItem[]
  enrollments      Enrollment[]
  lessonProgress   LessonProgress[]
  dailySales       DailySales[]
  dailyCompletions DailyCompletions[]
  outboxEvents     OutboxEvent[]
  auditEvents      AuditEvent[]
  coupons          Coupon[]
  bundles          Bundle[]
  bundleCourses    BundleCourse[]

  @@map("schools")
}

model Membership {
  id        String         @id @default(uuid()) @db.Uuid
  schoolId  String         @map("school_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId])
  @@index([userId])
  @@map("memberships")
}

model Course {
  id          String       @id @default(uuid()) @db.Uuid
  schoolId    String       @map("school_id") @db.Uuid
  title       String
  slug        String
  description String?
  status      CourseStatus @default(draft)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  school           School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections         Section[]
  prices           Price[]
  orderItems       OrderItem[]
  enrollments      Enrollment[]
  dailySales       DailySales[]
  dailyCompletions DailyCompletions[]
  bundleCourses    BundleCourse[]

  @@unique([schoolId, slug])
  @@map("courses")
}

model Section {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  courseId String @map("course_id") @db.Uuid
  title    String
  position Int

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([schoolId])
  @@index([courseId, position])
  @@map("sections")
}

model Lesson {
  id              String     @id @default(uuid()) @db.Uuid
  schoolId        String     @map("school_id") @db.Uuid
  sectionId       String     @map("section_id") @db.Uuid
  title           String
  position        Int
  type            LessonType @default(text)
  /// 0 for lessons without a running time, such as text and PDFs.
  durationSeconds Int        @default(0) @map("duration_seconds")
  /// Object-storage key of the lesson's video or PDF; null until a file is attached.
  mediaKey        String?    @map("media_key")

  school   School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section  Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([schoolId])
  @@index([sectionId, position])
  @@map("lessons")
}

/// What a course costs. Money is integer minor units + ISO 4217 code.
/// What a course or a bundle costs; exactly one of `course_id` and `bundle_id` is set. Newest wins.
model Price {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  courseId  String?  @map("course_id") @db.Uuid
  bundleId  String?  @map("bundle_id") @db.Uuid
  amount    Int
  currency  String   @db.Char(3)
  createdAt DateTime @default(now()) @map("created_at")

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  course     Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  bundle     Bundle?     @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([schoolId])
  @@index([courseId])
  @@index([bundleId])
  @@map("prices")
}

/// Several of a school's courses sold together at one price (`prices.bundle_id`).
model Bundle {
  id          String       @id @default(uuid()) @db.Uuid
  schoolId    String       @map("school_id") @db.Uuid
  title       String
  slug        String
  description String?
  status      CourseStatus @default(draft)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  school     School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  courses    BundleCourse[]
  prices     Price[]
  orderItems OrderItem[]

  @@unique([schoolId, slug])
  @@index([schoolId])
  @@map("bundles")
}

/// A course in a bundle, in display order.
model BundleCourse {
  schoolId String @map("school_id") @db.Uuid
  bundleId String @map("bundle_id") @db.Uuid
  courseId String @map("course_id") @db.Uuid
  position Int

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bundle Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([bundleId, courseId])
  @@index([schoolId])
  @@index([courseId])
  @@map("bundle_courses")
}

model Order {
  id            String        @id @default(uuid()) @db.Uuid
  schoolId      String        @map("school_id") @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  status        OrderStatus   @default(pending)
  totalAmount   Int           @map("total_amount")
  currency      String        @db.Char(3)
  paymentMethod PaymentMethod @map("payment_method")
  /// The language the buyer checked out in (`en` or `km`); their receipt and welcome emails use it.
  locale        String        @default("en")
  /// The gateway's id for this payment (Stripe session, PayWay tran_id, KHQR md5); set once payment starts.
  providerRef   String?       @unique @map("provider_ref")
  /// The coupon used; null without one, or once the coupon is deleted (`total_amount` keeps the discount).
  couponId      String?       @map("coupon_id") @db.Uuid
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon      Coupon?      @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  enrollments Enrollment[]

  @@index([schoolId])
  @@index([userId])
  @@index([couponId])
  @@map("orders")
}

/// A school's discount code. Percent coupons set `percent_off`; fixed ones set `amount_off` (minor units) and `currency`.
model Coupon {
  id             String     @id @default(uuid()) @db.Uuid
  schoolId       String     @map("school_id") @db.Uuid
  /// Upper case; unique per school.
  code           String
  kind           CouponKind
  percentOff     Int?       @map("percent_off")
  amountOff      Int?       @map("amount_off")
  currency       String?    @db.Char(3)
  expiresAt      DateTime?  @map("expires_at")
  /// Paid orders allowed; null is unlimited.
  maxRedemptions Int?       @map("max_redemptions")
  createdAt      DateTime   @default(now()) @map("created_at")

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("coupons")
}

model OrderItem {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  orderId  String @map("order_id") @db.Uuid
  courseId String @map("course_id") @db.Uuid
  priceId  String  @map("price_id") @db.Uuid
  /// The bundle this course was bought in; null for a course bought alone.
  bundleId String? @map("bundle_id") @db.Uuid
  /// This course's share of what the order charged.
  amount   Int
  currency String  @db.Char(3)

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  price  Price   @relation(fields: [priceId], references: [id], onDelete: Restrict)
  bundle Bundle? @relation(fields: [bundleId], references: [id], onDelete: Restrict)

  @@index([schoolId])
  @@index([orderId])
  @@index([bundleId])
  @@map("order_items")
}

model Enrollment {
  id          String           @id @default(uuid()) @db.Uuid
  schoolId    String           @map("school_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  courseId    String           @map("course_id") @db.Uuid
  orderId     String?          @map("order_id") @db.Uuid
  source      EnrollmentSource
  expiresAt   DateTime?        @map("expires_at")
  /// Set once, when the student completes the course's last lesson.
  completedAt DateTime?        @map("completed_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  school   School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order    Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  progress LessonProgress[]

  @@unique([userId, courseId])
  @@index([schoolId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  id                   String    @id @default(uuid()) @db.Uuid
  schoolId             String    @map("school_id") @db.Uuid
  enrollmentId         String    @map("enrollment_id") @db.Uuid
  lessonId             String    @map("lesson_id") @db.Uuid
  videoPositionSeconds Int       @default(0) @map("video_position_seconds")
  completedAt          DateTime? @map("completed_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([schoolId])
  @@index([lessonId])
  @@map("lesson_progress")
}

/// Pre-aggregated sales for the dashboard: one row per course, UTC day and currency, bumped when an order is confirmed paid.
model DailySales {
  id       String   @id @default(uuid()) @db.Uuid
  schoolId String   @map("school_id") @db.Uuid
  courseId String   @map("course_id") @db.Uuid
  day      DateTime @db.Date
  currency String   @db.Char(3)
  /// Paid orders, one student each.
  sales    Int      @default(0)
  /// Sum of the paid amounts in minor units; bigint, since riel totals pass 2^31 quickly.
  revenue  BigInt   @default(0)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([schoolId, courseId, day, currency])
  @@index([courseId])
  @@map("daily_sales")
}

/// Pre-aggregated course completions for the dashboard: one row per course and UTC day.
model DailyCompletions {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  courseId    String   @map("course_id") @db.Uuid
  day         DateTime @db.Date
  completions Int      @default(0)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([schoolId, courseId, day])
  @@index([courseId])
  @@map("daily_completions")
}

/// A domain event (`OrderPaid`, `CourseCompleted`) written in the transaction of the change it records;
/// the worker relays unpublished ones to the job queue.
model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  type        String
  payload     Json
  occurredAt  DateTime  @default(now()) @map("occurred_at")
  /// Set once the relay has queued the event.
  publishedAt DateTime? @map("published_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([publishedAt, occurredAt])
  @@index([schoolId])
  @@map("outbox_events")
}

/// What a school's staff did (create, edit, delete, settings), written after the action succeeded.
model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  /// Null once the staff member's account is deleted; the entry stays.
  actorId   String?  @map("actor_id") @db.Uuid
  /// `<thing>.<what was done>`, e.g. `course.update`.
  action    String
  /// The id of what was acted on: a course, a lesson, the school.
  targetId  String   @map("target_id")
  /// The request that did it, to find its logs.
  requestId String   @map("request_id")
  createdAt DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@map("audit_events")
}
