  "info": {
    "title": "Reanit API",
    "description": "REST API of Reanit LMS. Errors are RFC 9457 application/problem+json.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "SignUpBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "email": {
                "type": "string"
              },
              "name": {
                "nullable": true,
                "type": "string"
              }
            },
            "required": [
              "id",
              "email",
              "name"
            ]
          }
        },
        "required": [
          "user"
        ]
      },
      "LogInBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "MagicLinkBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "next": {
            "type": "string"
          },
          "locale": {
            "default": "en",
            "type": "string",
            "enum": [
              "en",
              "km"
            ]
          }
        },
        "required": [
          "email"
        ]
      },
      "CreateSchoolBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "subdomain": {
            "type": "string",
            "minLength": 3,
            "maxLength": 63,
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
          }
        },
        "required": [
          "name",
          "subdomain"
        ]
      },
      "SchoolResponse": {
        "type": "object",
        "properties": {
          "school": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "name": {
                "type": "string"
              },
              "subdomain": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "subdomain"
            ]
          }
        },
        "required": [
          "school"
        ]
      },
      "StaffSchoolResponse": {
        "type": "object",
        "properties": {
          "school": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "name": {
                "type": "string"
              },
              "subdomain": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "subdomain"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "instructor",
              "student"
            ]
          }
        },
        "required": [
          "school",
          "role"
        ]
      },
      "PublicSchoolResponse": {
        "type": "object",
        "properties": {
          "school": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "name": {
                "type": "string"
              },
              "subdomain": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "subdomain"
            ]
          },
          "owner": {
            "type": "object",
            "properties": {
              "name": {
                "nullable": true,
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "required": [
          "school",
          "owner"
        ]
      },
      "CoursesResponse": {
        "type": "object",
        "properties": {
          "courses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "title": {
                  "type": "string"
                },
                "slug": {
                  "type": "string"
                },
                "description": {
                  "nullable": true,
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "draft",
                    "published"
                  ]
                }
              },
              "required": [
                "id",
                "title",
                "slug",
                "description",
                "status"
              ]
            }
          }
        },
        "required": [
          "courses"
        ]
      },
      "CreateCourseBody": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "title"
        ]
      },
      "CourseResponse": {
        "type": "object",
        "properties": {
          "course": {
            "type": "object",
            "properties": {
              "id": {
