# Server env, validated by src/server/env.ts. Defaults match infra/docker-compose.yml.
DATABASE_URL=postgresql://reanit:reanit@localhost:5432/reanit
APP_URL=http://localhost:3000
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Reanit <no-reply@reanit.localhost>"
# Schools are served at <subdomain>.ROOT_DOMAIN (browsers resolve *.localhost). Unset disables subdomains.
ROOT_DOMAIN=localhost:3000
