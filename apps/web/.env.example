# Server env, validated by src/server/env.ts. Defaults match apps/api/.env.example.
API_URL=http://localhost:4000
# Schools are served at <subdomain>.ROOT_DOMAIN (browsers resolve *.localhost). Unset disables subdomains.
ROOT_DOMAIN=localhost:3000
# Observability (OPS-01), validated by src/telemetry/env.ts: each is off when unset.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
# NEXT_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# NEXT_PUBLIC_DEPLOY_ENV=development
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
