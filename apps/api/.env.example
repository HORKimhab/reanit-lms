# Validated at boot by src/config/env.ts. Defaults match infra/docker-compose.yml.
DATABASE_URL=postgresql://reanit:reanit@localhost:5432/reanit
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Reanit <no-reply@reanit.localhost>"
# Lesson files (SeaweedFS from infra/docker-compose.yml locally, R2 in production).
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=reanit-media
S3_ACCESS_KEY_ID=reanit
S3_SECRET_ACCESS_KEY=reanit-secret
S3_FORCE_PATH_STYLE=true
# Payment gateways: each is offered at checkout only when its credentials are set.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYWAY_MERCHANT_ID=...
# PAYWAY_API_KEY=...
# PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
# BAKONG_ACCOUNT_ID=...@aclb
# BAKONG_TOKEN=...
# BAKONG_MERCHANT_NAME=Reanit
# BAKONG_MERCHANT_CITY=Phnom Penh
# BAKONG_BASE_URL=https://sit-api-bakong.nbc.gov.kh
# Custom domains (Cloudflare for SaaS, infra/deploy/README.md): offered only when all three are set.
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ZONE_ID=...
# CUSTOM_DOMAIN_TARGET=customers.reanit.com
# End-to-end tests only (`pnpm e2e` sets it): card payments are faked and pay at once. Refused unless APP_URL is localhost.
# FAKE_PAYMENTS=true
PORT=4000
LOG_LEVEL=info
# Proxies in front of the API that append to X-Forwarded-For (load balancer, the web app), so rate limits
# count the browser's address. 0 trusts none; never set it higher than the proxies there are.
TRUST_PROXY_HOPS=0
# Observability (OPS-01): each is off when unset. DEPLOY_ENV names the deployment in errors and traces.
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# DEPLOY_ENV=development
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Platform admins, comma-separated: they list payouts due and record the transfers made.
PLATFORM_ADMIN_EMAILS=
