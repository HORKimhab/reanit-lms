{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --onSuccess \"node --env-file-if-exists=.env --enable-source-maps --import ./dist/instrument.js dist/main.js\"",
    "start": "node --env-file-if-exists=.env --enable-source-maps --import ./dist/instrument.js dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi": "tsup && node dist/openapi.js ../../packages/api-client/openapi.json",
    "storage:setup": "node --env-file-if-exists=.env dist/storage-setup.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@fastify/cookie": "catalog:",
    "@fastify/helmet": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/terminus": "catalog:",
    "@nestjs/throttler": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/auto-instrumentations-node": "catalog:",
    "@opentelemetry/instrumentation": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@sentry/node": "catalog:",
    "bakong-khqr": "catalog:",
    "fastify": "catalog:",
    "ioredis": "catalog:",
    "nestjs-cls": "catalog:",
    "nestjs-pino": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "stripe": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "catalog:",
    "@reanit/config": "workspace:*",
    "@reanit/core": "workspace:*",
    "@reanit/db": "workspace:*",
    "@reanit/email": "workspace:*",
    "@reanit/nest": "workspace:*",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "eslint": "catalog:",
    "supertest": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
