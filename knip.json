{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/ui": {
      "entry": [
        "src/components/*.tsx",
        "src/lib/*.ts"
      ]
    },
    "packages/db": {
      "ignoreDependencies": [
        "@prisma/client"
      ]
    },
    "packages/config": {
      "ignoreUnresolved": [
        "next"
      ]
    },
    "apps/api": {
      "entry": [
        "src/main.ts",
        "src/openapi.ts",
        "src/storage-setup.ts"
      ]
    },
    "apps/worker": {
      "entry": [
        "src/main.ts"
      ]
    }
  }
}
